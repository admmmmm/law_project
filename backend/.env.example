APP_NAME=Procuratorial Investigation Portrait Backend
APP_ENV=dev
API_PREFIX=/api/v1

# Algorithm provider: hipporag is the real chain; stub is only for emergency API debugging.
ALGORITHM_PROVIDER=hipporag
MEMORY_AUTO_WRITEBACK=false
STORAGE_DB_PATH=../outputs/backend_state.sqlite3

# HippoRAG / DeepSeek / BGE-M3
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_ANALYSIS_MODEL=deepseek-reasoner
DEEPSEEK_ANALYSIS_TIMEOUT=90
DEEPSEEK_ANALYSIS_ENABLED=true
HIPPORAG_LLM_NAME=deepseek-chat
HIPPORAG_LLM_BASE_URL=https://api.deepseek.com
HIPPORAG_EMBEDDING_MODEL=C:\Users\adm14\.cache\huggingface\hub\BAAI\bge-m3
HIPPORAG_SAVE_DIR=../outputs/hipporag_cases
HIPPORAG_MAX_DOCS=240
HIPPORAG_PASSAGE_MAX_CHARS=120
HIPPORAG_TRACE_WINDOW_CHARS=220
HIPPORAG_RETRIEVAL_TOP_K=8
HIPPORAG_FAIL_FAST=true
HIPPORAG_ENABLE_QA=true
HIPPORAG_QA_TOP_K=5

# Keep model loading local once BGE-M3 is downloaded.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
